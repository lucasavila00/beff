{
  "name": "@beff/client",
  "version": "1.0.0",
  "description": "",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lucasavila00/beff.git",
    "directory": "packages/beff-client"
  },
  "type": "module",
  "sideEffects": false,
  "main": "dist/cjs/index.js",
  "scripts": {
    "build": "tsc -b ./tsconfig.cjs.json ./tsconfig.esm.json ./tsconfig.types.json && node ./script/fixup-package.mjs",
    "test": "vitest --run --update"
  },
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "require": "./dist/cjs/index.js",
      "import": "./dist/esm/index.js",
      "default": "./dist/esm/index.js"
    },
    "./runtime": {
      "types": "./dist/types/runtime.d.ts",
      "require": "./dist/cjs/runtime.js",
      "import": "./dist/esm/runtime.js",
      "default": "./dist/esm/runtime.js"
    }
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@beff/cli": "workspace:^1.0.0"
  },
  "devDependencies": {
    "typescript": "^5.2.2",
    "vitest": "^0.34.4"
  }
}
